from manim import *

MaybachRainNight（场景）：
def construct(self):
# 设置背景（雨夜）
self.camera.background_color = "#111111"
        
# 添加雨滴效果
rain = VGroup(*[Line(UP*0.5, DOWN*0.5, color=BLUE) for _ in range(100)])
排列_in_grid（rows=20，cols=5，buff=0.5）
rain.add_updater(lambda m, dt: m.shift(DOWN*dt*2))
        
# 创建迈巴赫汽车简化模型
car_body=Rectangle（高度=1，宽度=2.5，颜色=灰色，fill_option=1）
front_window = Polygon(
[-1, 0.5, 0], [-0.5, 1, 0], [0.5, 1, 0], [1, 0.5, 0],
color=BLUE_E, fill_opacity=0.8
        )
wheels = VGroup(
圆（半径=0.3，颜色=黑色，fill_option=1）
圆（radius=0.3，color=BLACK，fill_option=1）. shift（右*0.8+向下*0.5）
        )
maybach = VGroup(car_body, front_window, wheels).scale(0.8)
        
# 添加车灯效果
大灯=VGroup
行（ORIGIN，UP*0.5，color=YELLOW，stroke_width=10），
行（ORIGIN，UP*0.3+RIGHT*0.3，color=YELLOW，stroke_width=10），
行（ORIGIN，UP*0.3+LEFT*0.3，color=YELLOW，stroke_width=10）
shift（右*1.5+下*0.2）
        maybach.add(headlight)

# 设置初始位置
maybach.move_to（左*4+下*0.5）
        
# 添加路面
road=Line（左*10，右*10，color=GREY）. shift（下*2）
road_reflection = VGroup(*[
行（ORIGIN，RIGHT*0.3，color=WHITE，stroke_width=2）
范围内_（20）
]）. Relar（右，buff=0.5）. shift（下*2+左*5）
        
# 添加所有元素到场景
self.add(rain, road, road_reflection, maybach)
        
# 添加移动动画（10秒）
        self.play(
            maybach.animate.shift(RIGHT*10),
            road_reflection.animate.shift(RIGHT*10),
            run_time=10,
            rate_func=linear
        )
        
# 添加音效提示（需要准备音频文件）
self.add_sound（"rain_thunder.wav"）#需要自行准备音效文件

# 使用方法：
#1。安装 Manim:pip install Manim
# 2. 准备音效文件（可选）
#3。运行命令:manim-pql Maybach_scene. py MaybachRainNight
